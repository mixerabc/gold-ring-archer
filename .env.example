# GOLD RING server configuration.
# Copy to .env and adjust. The client never sees these values.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Comma-separated list of allowed client origins, or leave unset for any.
# CORS_ORIGIN=http://localhost:5173,https://gold-ring.example.com

# Where the JSON store lives. Use a mounted volume in production.
DATA_DIR=./data

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Requests per minute per IP.
RATE_LIMIT_MAX=240

# The server is authoritative for shots. It rejects a claimed score that does
# not match its own replay of the shared physics.


# ---------------------------------------------------------------------------
# Client build variables (set these in Netlify / Vercel, not in this file)
# ---------------------------------------------------------------------------
# VITE_API_URL=https://gold-ring-server.onrender.com
# VITE_WS_URL=wss://gold-ring-server.onrender.com/ws
